{
  "name": "connector-kit",
  "version": "0.3.0",
  "private": true,
  "description": "Agent-first TypeScript library for safe SaaS API connectors: typed actions, pagination, retries, rate limits, and LLM tools.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./airtable": {
      "types": "./dist/connectors/airtable/index.d.ts",
      "default": "./dist/connectors/airtable/index.js"
    },
    "./asana": {
      "types": "./dist/connectors/asana/index.d.ts",
      "default": "./dist/connectors/asana/index.js"
    },
    "./calendly": {
      "types": "./dist/connectors/calendly/index.d.ts",
      "default": "./dist/connectors/calendly/index.js"
    },
    "./digitalocean": {
      "types": "./dist/connectors/digitalocean/index.d.ts",
      "default": "./dist/connectors/digitalocean/index.js"
    },
    "./figma": {
      "types": "./dist/connectors/figma/index.d.ts",
      "default": "./dist/connectors/figma/index.js"
    },
    "./github": {
      "types": "./dist/connectors/github/index.d.ts",
      "default": "./dist/connectors/github/index.js"
    },
    "./gitlab": {
      "types": "./dist/connectors/gitlab/index.d.ts",
      "default": "./dist/connectors/gitlab/index.js"
    },
    "./hubspot": {
      "types": "./dist/connectors/hubspot/index.d.ts",
      "default": "./dist/connectors/hubspot/index.js"
    },
    "./intercom": {
      "types": "./dist/connectors/intercom/index.d.ts",
      "default": "./dist/connectors/intercom/index.js"
    },
    "./netlify": {
      "types": "./dist/connectors/netlify/index.d.ts",
      "default": "./dist/connectors/netlify/index.js"
    },
    "./pipedrive": {
      "types": "./dist/connectors/pipedrive/index.d.ts",
      "default": "./dist/connectors/pipedrive/index.js"
    },
    "./slack": {
      "types": "./dist/connectors/slack/index.d.ts",
      "default": "./dist/connectors/slack/index.js"
    },
    "./vercel": {
      "types": "./dist/connectors/vercel/index.d.ts",
      "default": "./dist/connectors/vercel/index.js"
    },
    "./zoom": {
      "types": "./dist/connectors/zoom/index.d.ts",
      "default": "./dist/connectors/zoom/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "default": "./dist/mcp.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "connector-kit-mcp": "./dist/bin/mcp.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.5",
  "homepage": "https://github.com/itzzzzzzak/connector-kit#readme",
  "bugs": {
    "url": "https://github.com/itzzzzzzak/connector-kit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itzzzzzzak/connector-kit.git"
  },
  "keywords": [
    "ai-agents",
    "llm-tools",
    "mcp",
    "connectors",
    "integrations",
    "saas",
    "api-client",
    "oauth",
    "typescript"
  ],
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "npm run build && tsc -p tsconfig.json --noEmit && tsc -p examples/tsconfig.json --noEmit",
    "test": "node -e \"fs.rmSync('.test-dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && node --test \".test-dist/**/*.test.js\"",
    "example:quickstart": "node examples/quickstart.ts",
    "prepack": "npm run build",
    "smoke": "node scripts/smoke-install.mjs",
    "sync": "node scripts/sync-exports.mjs",
    "catalog": "npm run build && node scripts/catalog.mjs",
    "check:generated": "node scripts/sync-exports.mjs --check && node scripts/catalog.mjs --check",
    "new:connector": "node scripts/new-connector.mjs"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "typescript": "^5.6.0"
  }
}
