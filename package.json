{
  "name": "connector-kit",
  "version": "0.0.0",
  "private": true,
  "description": "Agent-first TypeScript library for safe SaaS API connectors: typed actions, pagination, retries, rate limits, and LLM tools.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./github": {
      "types": "./dist/connectors/github/index.d.ts",
      "default": "./dist/connectors/github/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.5",
  "homepage": "https://github.com/itzzzzzzak/connector-kit#readme",
  "bugs": {
    "url": "https://github.com/itzzzzzzak/connector-kit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itzzzzzzak/connector-kit.git"
  },
  "keywords": [
    "ai-agents",
    "llm-tools",
    "mcp",
    "connectors",
    "integrations",
    "saas",
    "api-client",
    "oauth",
    "typescript"
  ],
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "npm run build && tsc -p tsconfig.json --noEmit && tsc -p examples/tsconfig.json --noEmit",
    "test": "node -e \"fs.rmSync('.test-dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && node --test \".test-dist/**/*.test.js\"",
    "example:quickstart": "node examples/quickstart.ts",
    "prepack": "npm run build",
    "smoke": "node scripts/smoke-install.mjs"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
